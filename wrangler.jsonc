{
  "name": "otsukai-ai",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "vars": {
    "MODEL": "claude-sonnet-5-5",
    "SITE_URL": "https://otsukai-ai.example.workers.dev/"
  }
  // 秘密の値は `npx wrangler secret put 名前` で入れる:
  // ANTHROPIC_API_KEY, RAKUTEN_APP_ID, RAKUTEN_ACCESS_KEY, RAKUTEN_AFFILIATE_ID(任意)
  // Amazonも探すなら: AMAZON_CREDENTIAL_ID, AMAZON_CREDENTIAL_SECRET, AMAZON_CREDENTIAL_VERSION(3.3), AMAZON_PARTNER_TAG
}
